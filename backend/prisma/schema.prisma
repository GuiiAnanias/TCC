// [BANCO] Modelo do banco de dados (PostgreSQL) usado pelo Prisma. Cada model vira uma tabela (nome
// em @@map) e cada enum, um tipo do PostgreSQL.
// Mudanças aqui exigem uma migration nova em prisma/migrations (pnpm exec prisma migrate
// dev --name descricao). Regras que o banco garante sozinho (gatilhos, travas de histórico) estão
// nos arquivos migration.sql; ver docs/guia-do-codigo.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// [BANCO] Situação de cadastro: Ativo ou Inativo (inativar em vez de apagar).
enum Status {
  ATIVO
  INATIVO
}

enum TipoPessoa {
  PF
  PJ
}

// [BANCO][REGRA] Tipos de contrato de projeto (migration 20261111010000_tipos_contrato_genericos).
enum TipoContrato {
  ESCOPO_FECHADO
  POR_HORA
  FEE_MENSAL
  SQUAD
}

enum StatusProjeto {
  ATIVO
  PAUSADO
  ENCERRADO
  CANCELADO
}

enum TipoBonificacao {
  NENHUMA
  VALOR_FIXO
  PERCENTUAL
}

// [BANCO][REGRA] Fluxo das horas: Pendente, Aprovado e Faturado (faturado trava a edição).
enum StatusApontamento {
  PENDENTE
  APROVADO
  FATURADO
}

enum StatusTarefa {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

// [BANCO][SEGURANCA] Contas de acesso. senhaHash guarda o bcrypt; resetToken guarda só o hash do
// token de recuperação; versaoSessao derruba sessões antigas ao trocar a senha.
model Usuario {
  id                  Int       @id @default(autoincrement())
  nomeUsuario         String    @unique
  email               String    @unique
  senhaHash           String
  versaoSessao        Int       @default(0)
  sessoes             Sessao[]
  resetToken          String?
  resetTokenExpiraEm  DateTime?
  status              Status    @default(ATIVO)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  configuracoesCriadas ConfiguracaoFinanceira[] @relation("AutorConfiguracaoFinanceira")
  configuracoesEncerradas ConfiguracaoFinanceira[] @relation("AutorEncerramentoFinanceiro")
  regrasPremiacao RegraPremiacao[]
  avaliacoesCriadas AvaliacaoPremiacao[] @relation("AutorAvaliacao")
  avaliacoesConcluidas AvaliacaoPremiacao[] @relation("ConclusaoAvaliacao")
  relatoriosGerados RelatorioGerado[]
  exportacoesRelatorios RelatorioExportacao[]
  importacoesApontamentos ImportacaoApontamentos[]
  historicosApontamentos HistoricoApontamento[]

  @@map("usuarios")
}

// [BANCO][SEGURANCA] Uma linha por login; o JWT carrega o id (jti) desta sessão. Logout preenche
// revogadaEm.
model Sessao {
  id            String   @id
  usuarioId     Int
  versaoSessao  Int
  expiraEm      DateTime
  revogadaEm    DateTime?
  createdAt     DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, expiraEm])
  @@map("sessoes")
}

// [BANCO][SEGURANCA] Contadores de tentativas de login e recuperação de senha (chave em HMAC).
// No login por usuário, nivel e bloqueadoAte guardam o bloqueio progressivo (10 s, 1 min, 5 min).
model LimiteAutenticacao {
  chave        String    @id
  tentativas   Int
  expiraEm     DateTime
  nivel        Int       @default(0)
  bloqueadoAte DateTime?

  @@index([expiraEm])
  @@map("limites_autenticacao")
}

// [BANCO] Clientes PF e PJ. CNPJ e CPF únicos; campos da Receita só para PJ.
model Cliente {
  id        Int       @id @default(autoincrement())
  nome      String
  tipoPessoa TipoPessoa @default(PJ)
  cpf       String?   @unique
  cnpj      String?   @unique
  nomeFantasia String?
  email String?
  telefone String?
  contato String?
  cep String?
  logradouro String?
  numero String?
  complemento String?
  bairro String?
  cidade String?
  estado String?
  situacaoCadastral String?
  abertura String?
  porte String?
  naturezaJuridica String?
  atividadePrincipal String?
  status    Status    @default(ATIVO)
  projetos  Projeto[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("clientes")
}

// [BANCO] Pessoas da empresa. Cargo e departamento descrevem a atuação; o valor/hora fica em
// ConfiguracaoFinanceira.
model Colaborador {
  id                         Int                       @id @default(autoincrement())
  nomeCompleto               String
  email                      String                    @unique
  cargo                      String
  departamento               String
  status                     Status                    @default(ATIVO)
  configuracoesFinanceiras   ConfiguracaoFinanceira[]
  projetos                   ProjetoColaborador[]
  apontamentos               ApontamentoHora[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  tarefasResponsaveis TarefaResponsavel[]
  avaliacoesPremiacao         AvaliacaoPremiacao[]

  @@map("colaboradores")
}

// [BANCO] Tabela de remuneração: um nível (ex.: Pleno II) e seu valor/hora.
model ItemTabelaRemuneracao {
  id                         Int                       @id @default(autoincrement())
  nivel                      String                    @unique
  valorHora                  Decimal                   @db.Decimal(10, 2)
  bonificacao                Decimal                   @default(0) @db.Decimal(10, 2)
  tipoBonificacao            TipoBonificacao           @default(NENHUMA)
  status                     Status                    @default(ATIVO)
  configuracoesFinanceiras   ConfiguracaoFinanceira[]
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@map("itens_tabela_remuneracao")
}

// [BANCO][REGRA] Percentual de bonificação por papel no projeto, com vigência (dataInicio/dataFim).
model BonificacaoPapel {
  id          Int       @id @default(autoincrement())
  papel       String
  percentual  Decimal   @db.Decimal(10, 2)
  dataInicio  DateTime  @db.Date
  dataFim     DateTime? @db.Date
  createdAt   DateTime  @default(now())

  @@index([papel, dataInicio])
  @@map("bonificacoes_papeis")
}

// [BANCO][REGRA] Vigências de valor/hora de cada colaborador. Histórico imutável (gatilho no
// banco); uma nova vigência fecha a anterior.
model ConfiguracaoFinanceira {
  id              Int                     @id @default(autoincrement())
  colaboradorId   Int
  itemTabelaId    Int
  beneficios      Decimal                 @default(0) @db.Decimal(10, 2)
  valorHoraAplicado Decimal                @db.Decimal(10, 2)
  nivelAplicado   String
  origemValorHora String                  @default("VINCULO")
  motivo          String                  @default("Nova vigência")
  anteriorId      Int?                    @unique
  anterior        ConfiguracaoFinanceira? @relation("VersoesFinanceiras", fields: [anteriorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "financeiro_anterior_fkey")
  proxima         ConfiguracaoFinanceira? @relation("VersoesFinanceiras")
  criadoPorId     Int?
  criadoPor       Usuario?                @relation("AutorConfiguracaoFinanceira", fields: [criadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "financeiro_autor_fkey")
  encerradoPorId  Int?
  encerradoPor    Usuario?                @relation("AutorEncerramentoFinanceiro", fields: [encerradoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "financeiro_encerrado_por_fkey")
  dataInicio      DateTime
  dataFim         DateTime?
  colaborador     Colaborador             @relation(fields: [colaboradorId], references: [id])
  itemTabela      ItemTabelaRemuneracao   @relation(fields: [itemTabelaId], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([colaboradorId, dataInicio, dataFim])
  @@map("configuracoes_financeiras")
}

// [BANCO] Projetos de um cliente: tipo de contrato, horas contratadas, valor (orçamento) e status.
model Projeto {
  id                Int                    @id @default(autoincrement())
  clienteId         Int
  nome              String
  tipoContrato      TipoContrato
  horasContratadas  Decimal                @db.Decimal(10, 2)
  valorProjeto      Decimal                @db.Decimal(12, 2)
  dataInicio        DateTime
  status            StatusProjeto          @default(ATIVO)
  cliente           Cliente                @relation(fields: [clienteId], references: [id])
  equipe            ProjetoColaborador[]
  avaliacoes        ProjetoAvaliacao[]
  relatorios        ProjetoRelatorio[]
  apontamentos      ApontamentoHora[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([clienteId])
  sprints Sprint[]
  tarefas Tarefa[]

  @@map("projetos")
}

// [BANCO][REGRA] Participação de um colaborador na equipe do projeto, com papel e período (sem
// sobreposição).
model ProjetoColaborador {
  id             Int           @id @default(autoincrement())
  projetoId      Int
  colaboradorId  Int
  papel          String
  dataEntrada    DateTime
  dataSaida      DateTime?
  projeto        Projeto       @relation(fields: [projetoId], references: [id])
  colaborador    Colaborador   @relation(fields: [colaboradorId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([projetoId])
  @@index([colaboradorId])
  @@map("projetos_colaboradores")
}

// [BANCO][REGRA] Horas trabalhadas. custoConsolidado guarda a composição do custo no faturamento e
// historicoCustos, todas as versões.
model ApontamentoHora {
  id             Int                @id @default(autoincrement())
  colaboradorId  Int
  projetoId      Int
  tarefaId       Int?
  data           DateTime           @db.Date
  horas          Decimal            @db.Decimal(5, 2)
  status         StatusApontamento  @default(PENDENTE)
  descricao      String

  // Apuradas e versionadas pelo banco ao faturar, inclusive na importação Excel.
  custoConsolidado Json?
  historicoCustos  Json @default("[]")

  colaborador    Colaborador        @relation(fields: [colaboradorId], references: [id])
  projeto        Projeto            @relation(fields: [projetoId], references: [id])
  tarefa         Tarefa?            @relation(fields: [tarefaId, projetoId], references: [id, projetoId], onDelete: Restrict, onUpdate: NoAction)

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([colaboradorId])
  @@index([projetoId])
  @@index([tarefaId, projetoId])
  @@map("apontamentos_horas")
}


// [BANCO] Sprints de um projeto (arquivadas por statusRegistro, sem exclusão).
model Sprint {
  id            Int       @id @default(autoincrement())
  projetoId     Int
  nome          String
  descricao     String?
  dataInicio    DateTime? @db.Date
  dataFim       DateTime? @db.Date
  statusRegistro Status   @default(ATIVO)
  origem        String    @default("MANUAL")
  externalId    String?
  projeto       Projeto   @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  tarefas       Tarefa[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([id, projetoId])
  @@unique([projetoId, origem, externalId])
  @@index([projetoId, statusRegistro])
  @@map("sprints")
}

// [BANCO] Tarefas de um projeto: status, estimativa em minutos, marca de correção e responsáveis.
model Tarefa {
  id               Int          @id @default(autoincrement())
  projetoId        Int
  sprintId         Int?
  titulo           String
  descricao        String?
  status           StatusTarefa @default(PLANEJADA)
  statusOrigem     String?
  minutosEstimados Int?
  correcao         Boolean      @default(false)
  dataInicio       DateTime?    @db.Date
  dataConclusao    DateTime?    @db.Date
  statusRegistro   Status       @default(ATIVO)
  origem           String       @default("MANUAL")
  externalId       String?
  projeto          Projeto      @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  sprint           Sprint?      @relation(fields: [sprintId, projetoId], references: [id, projetoId], onDelete: Restrict, onUpdate: NoAction)
  responsaveis     TarefaResponsavel[]
  apontamentos     ApontamentoHora[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([id, projetoId])
  @@unique([projetoId, origem, externalId])
  @@index([projetoId, statusRegistro, status])
  @@index([sprintId, projetoId])
  @@map("tarefas")
}

// [BANCO] Responsáveis de cada tarefa (ligação tarefa x colaborador).
model TarefaResponsavel {
  tarefaId      Int
  colaboradorId Int
  tarefa        Tarefa      @relation(fields: [tarefaId], references: [id], onDelete: Restrict)
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict)

  @@id([tarefaId, colaboradorId])
  @@index([colaboradorId])
  @@map("tarefas_responsaveis")
}


// [BANCO][REGRA] Versões publicadas das regras de premiação (imutáveis).
model RegraPremiacao {
  id Int @id @default(autoincrement())
  nome String
  categoria String
  definicao Json
  criadoPorId Int
  criadoPor Usuario @relation(fields: [criadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now())
  avaliacoes AvaliacaoPremiacao[]
  @@map("regras_premiacao")
}

// [BANCO][REGRA] Avaliações de premiação: rascunho, conclusão e versões de reavaliação.
model AvaliacaoPremiacao {
  id Int @id @default(autoincrement())
  colaboradorId Int
  competencia String
  categoria String
  versao Int @default(1)
  revisao Int @default(1)
  status String @default("RASCUNHO")
  regraId Int
  conteudo Json
  projetos ProjetoAvaliacao[]
  criadoPorId Int
  concluidoPorId Int?
  concluidoEm DateTime?
  anteriorId Int? @unique
  anterior AvaliacaoPremiacao? @relation("RevisoesPremiacao", fields: [anteriorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  proxima AvaliacaoPremiacao? @relation("RevisoesPremiacao")
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  regra RegraPremiacao @relation(fields: [regraId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  criadoPor Usuario @relation("AutorAvaliacao", fields: [criadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  concluidoPor Usuario? @relation("ConclusaoAvaliacao", fields: [concluidoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([colaboradorId, competencia, categoria, versao])
  @@map("avaliacoes_premiacao")
}

// [BANCO] Projetos usados em cada avaliação (impede a exclusão definitiva desses projetos).
model ProjetoAvaliacao {
  projetoId Int
  avaliacaoId Int
  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  avaliacao AvaliacaoPremiacao @relation(fields: [avaliacaoId], references: [id], onDelete: Restrict)

  @@id([projetoId, avaliacaoId])
  @@index([avaliacaoId])
  @@map("projetos_avaliacoes")
}

// Fotografia de um relatório gerado: filtros, blocos e dados no momento da geração.
// Imutável no banco; a prévia e as exportações leem sempre esta cópia.
model RelatorioGerado {
  id          Int                @id @default(autoincrement())
  versao      Int                @default(1)
  filtros     Json
  blocos      String[]
  conteudo    Json
  criadoPorId Int
  criadoPor   Usuario            @relation(fields: [criadoPorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  projetos    ProjetoRelatorio[]
  exportacoes RelatorioExportacao[]
  createdAt   DateTime           @default(now())

  @@index([createdAt])
  @@index([criadoPorId])
  @@map("relatorios_gerados")
}

// [BANCO] Projetos de cada relatório gerado, para filtrar o histórico por projeto.
model ProjetoRelatorio {
  projetoId   Int
  relatorioId Int
  projeto     Projeto         @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  relatorio   RelatorioGerado @relation(fields: [relatorioId], references: [id], onDelete: Restrict)

  @@id([projetoId, relatorioId])
  @@index([relatorioId])
  @@map("relatorios_projetos")
}

// Cada download de PDF ou Excel de um relatório gerado: o histórico mostra os formatos já
// exportados. O arquivo não é guardado; é gerado de novo a partir da fotografia.
model RelatorioExportacao {
  id          Int             @id @default(autoincrement())
  relatorioId Int
  formato     String
  usuarioId   Int
  relatorio   RelatorioGerado @relation(fields: [relatorioId], references: [id], onDelete: Restrict)
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt   DateTime        @default(now())

  @@index([relatorioId])
  @@map("relatorios_exportacoes")
}

// Histórico das importações de apontamentos por planilha (concluídas e com falha).
// Projetos e erros ficam como cópia em JSON: o registro conta o que aconteceu na hora,
// sem impedir mudanças futuras nos cadastros. O arquivo em si não é guardado.
model ImportacaoApontamentos {
  id            Int       @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  arquivo       String
  status        String
  mensagem      String?
  linhas        Int       @default(0)
  importados    Int       @default(0)
  comErro       Int       @default(0)
  horas         Decimal   @default(0) @db.Decimal(10, 2)
  periodoInicio DateTime? @db.Date
  periodoFim    DateTime? @db.Date
  projetos      Json      @default("[]")
  erros         Json      @default("[]")
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@map("importacoes_apontamentos")
}

// [BANCO][REGRA] Histórico de apontamentos modificados ou excluídos (auditoria).
// Os dados do apontamento ficam preservados em JSON (dadosAnteriores / dadosNovos) para que
// mesmo após a exclusão definitiva do apontamento o histórico continue completo.
model HistoricoApontamento {
  id              Int       @id @default(autoincrement())
  apontamentoId   Int
  situacao        String
  colaboradorId   Int
  colaboradorNome String
  projetoId       Int
  projetoNome     String
  tarefaId        Int?
  tarefaTitulo    String?
  data            DateTime  @db.Date
  horas           Decimal   @db.Decimal(5, 2)
  status          String
  descricao       String
  dadosAnteriores Json
  dadosNovos      Json?
  usuarioId       Int?
  usuario         Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt       DateTime  @default(now())

  @@index([situacao, createdAt])
  @@index([apontamentoId])
  @@index([colaboradorId])
  @@index([projetoId])
  @@map("historico_apontamentos")
}
